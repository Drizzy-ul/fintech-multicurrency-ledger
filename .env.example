# ==============================================================================
# Environment Configuration Template for FinTech Multi-Currency Ledger
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# Application Settings
PROJECT_NAME="FinTech Multi-Currency Ledger API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Authentication (Generate using: openssl rand -hex 32)
SECRET_KEY="generate-a-strong-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (PostgreSQL for production / Docker, SQLite for local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fintech_ledger"
# For local development without Docker:
# DATABASE_URL="sqlite:///./fintech_ledger.db"

# Redis & Celery Message Broker
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Foreign Exchange (FX) Rate Configuration
EXCHANGE_RATE_API_URL="https://open.er-api.com/v6/latest"
FX_CACHE_TTL_SECONDS=300
QUOTE_VALIDITY_SECONDS=60

# PDF Statement Storage
STORAGE_DIR="./storage/statements"
